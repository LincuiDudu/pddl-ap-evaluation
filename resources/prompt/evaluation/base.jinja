```json
{
  "F1": <int>, "F2": <int>, 
  "A1": <int>, "A2": <int>,
  "C1": <int>, "C2": <int>, "C3": <int>,
  "V1": <int>, "V2": <int>, "V3": <int>,
  "N1": <int>, "N2": <int>{% if extrinsic %},
